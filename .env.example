# Copy this file to ".env" and edit the values. Never commit ".env".

# Long random string used to sign login sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# First administrator. Used ONLY the first time the app starts (it creates the first account).
# After that, accounts live in the database: manage them on the Users page, and change passwords there.
# Locked out of everything?  python manage_users.py reset <username>
ADMIN_USERNAME=admin
# Option A (simple): plain password, hashed in memory when the app starts
ADMIN_PASSWORD=
# Option B (better): a pre-hashed password. Generate with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('YOUR-PASSWORD'))"
ADMIN_PASSWORD_HASH=

# 1 = simulated readings (demo). Set to 0 once real agents feed data.
DEMO_MODE=1
# Required for token-authenticated host, access point, and WAN telemetry in live mode.
# Generate a random value of at least 32 characters; install the same value on trusted agents.
TELEMETRY_TOKEN=

# Set to 1 when the site is served over HTTPS
SESSION_COOKIE_SECURE=0

# Optional
# DATABASE_PATH=instance/monitor.db
# HOST=127.0.0.1
# PORT=5000

# ---------------------------------------------------------------- switch monitoring
# In live mode the app runs a background poller. Disable it if you run collector.py separately.
# DEMO_MODE=0
SWITCH_MONITOR_ENABLED=1
# Use 2c with the read-only community, or 3 with the SNMPv3 profile below.
SWITCH_SNMP_VERSION=2c
# Read-only SNMPv2c community configured on the switches (never use "public" in production)
SNMP_COMMUNITY=
SNMP_PORT=161
SNMP_TIMEOUT=2
# SNMPv3 credentials are read from this local .env only; leave blank when using v2c.
SWITCH_SNMP_V3_USERNAME=
SWITCH_SNMP_V3_SECURITY_LEVEL=authPriv
SWITCH_SNMP_V3_AUTH_KEY=
SWITCH_SNMP_V3_AUTH_PROTOCOL=SHA
SWITCH_SNMP_V3_PRIV_KEY=
SWITCH_SNMP_V3_PRIV_PROTOCOL=AES128
# How often every switch is checked, and how many missed checks mean "unreachable"
SWITCH_POLL_SECONDS=30
SWITCH_MISS_LIMIT=2
# A port that drops this many times inside the window is reported as flapping
FLAP_LIMIT=3
FLAP_WINDOW_MINUTES=10
# Receive the switches' syslog messages (this is how attacks such as ARP spoofing are reported)
SYSLOG_ENABLED=0
SYSLOG_PORT=5514
# Lets other tools (Wazuh, Suricata, scripts) post switch events to /api/ingest/switch-event
INGEST_TOKEN=
# How often the browser asks for new alerts (seconds)
NOTIFY_SECONDS=5

# ---------------------------------------------------------------- one-switch trial
# Watch ONLY these switches (names or IPs, comma separated). Leave empty to watch all 13.
# Other switches then show "Not read yet" instead of a false alarm.
LIVE_TRIAL_SWITCHES=

# Access-point / guest Wi-Fi threshold examples (override to match site baselines).
# AP_CLIENTS_WARN=50
# AP_CLIENTS_THREAT=80
# AP_CHANNEL_WARN=70
# AP_CHANNEL_THREAT=90
# AP_RSSI_WARN=-75
# AP_RSSI_THREAT=-85
# GUEST_DNS_LATENCY_WARN_MS=250
# GUEST_DNS_LATENCY_THREAT_MS=1000
# GUEST_DHCP_LATENCY_WARN_MS=500
# GUEST_DHCP_LATENCY_THREAT_MS=2000
